{
  "description": "优化双评估器配置：GPT-4o-mini + DeepSeek v3，支持多线程加速",
  "judges": [
    {
      "model_name": "gpt-4o-mini",
      "api_base": "https://api.openai.com/v1",
      "api_key_env": "OPENAI_API_KEY",
      "temperature": 0.0,
      "enabled": true,
      "description": "OpenAI GPT-4o-mini 主评估器",
      "timeout": 30.0,
      "max_retries": 3
    },
    {
      "model_name": "ep-20250818122533-wkp8h",
      "api_base": "https://ark.cn-beijing.volces.com/api/v3",
      "api_key_env": "ARK_API_KEY",
      "temperature": 0.0,
      "enabled": true,
      "description": "火山 Ark DeepSeek v3 辅助评估器",
      "timeout": 30.0,
      "max_retries": 3
    }
  ],
  "performance_config": {
    "max_concurrent_requests": 8,
    "batch_size": 10,
    "request_delay": 0.1,
    "max_workers": 16,
    "memory_limit_gb": 32,
    "gpu_memory_utilization": 0.7
  },
  "metadata": {
    "version": "2.0",
    "created": "2024-08-19",
    "optimization": "multi_threading_enabled",
    "safety_features": {
      "memory_monitoring": true,
      "gpu_monitoring": true,
      "rate_limiting": true,
      "error_recovery": true
    }
  }
}
