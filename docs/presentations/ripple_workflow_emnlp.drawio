        <mxCell id="fb-lbl" value="&lt;span style=&quot;background:#FFE0E0;padding:2px 6px;border-radius:3px;color:#B85450;font-weight:bold&quot;&gt;Mitigation Feedback : add KL anchor on Hub QA → update set&lt;/span&gt;" style="text;html=1;align=center;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1080" y="770" width="380" height="20" as="geometry" />
        </mxCell>

        <!-- ============ BOTTOM SUMMARY BAND ============ -->
