        <mxCell id="bf1-title" value="&lt;b style=&quot;color:#1F4E79&quot;&gt;Stage 1 → G_fact &lt;/b&gt;&lt;span style=&quot;font-size:10px;color:#444&quot;&gt;(N-to-1 DAG, Wiki-verified)&lt;/span&gt;" style="text;html=1;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="50" y="855" width="580" height="20" as="geometry" />
