        <mxCell id="bf2-a12a" style="endArrow=classic;html=1;strokeColor=#888;" edge="1" parent="1" source="bf2-d1a" target="bf2-d2a"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="bf2-a12b" style="endArrow=classic;html=1;strokeColor=#888;" edge="1" parent="1" source="bf2-d1b" target="bf2-d2b"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="bf2-a12c" style="endArrow=classic;html=1;strokeColor=#888;" edge="1" parent="1" source="bf2-d1b" target="bf2-d2c"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="bf2-a12d" style="endArrow=classic;html=1;strokeColor=#888;" edge="1" parent="1" source="bf2-d1c" target="bf2-d2d"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="bf2-a23a" style="endArrow=classic;html=1;strokeColor=#888;" edge="1" parent="1" source="bf2-d2a" target="bf2-d3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="bf2-a23b" style="endArrow=classic;html=1;strokeColor=#888;" edge="1" parent="1" source="bf2-d2b" target="bf2-d3b"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="bf2-a23c" style="endArrow=classic;html=1;strokeColor=#888;" edge="1" parent="1" source="bf2-d2c" target="bf2-d3c"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- LoRA mix box -->
        <mxCell id="bf2-lora" value="&lt;b&gt;LoRA Update Set&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[ N_inj targeted &amp;nbsp;|&amp;nbsp; N_neut neutral &amp;nbsp;|&amp;nbsp; N_ood OOD ]&lt;br/&gt;θ → θ&apos;  (LCE on (s,r,o&apos;))&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;fontSize=10;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1090" y="1050" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="bf2-lora-arr" style="endArrow=classic;html=1;strokeColor=#444;strokeWidth=2;dashed=1;" edge="1" parent="1" source="bf2-d0" target="bf2-lora">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="715" y="1110" />
              <mxPoint x="1090" y="1110" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="bf2-cap" value="&lt;span style=&quot;font-size:10px&quot;&gt;Path-continuity: each d_k child requires its d_{k−1} parent to remain → enables P(E_d_k | E_d_{k−1}).&lt;/span&gt;" style="text;html=1;align=center;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="670" y="1150" width="560" height="30" as="geometry" />
        </mxCell>

        <!-- BAND FRAME 3: EPR curve sketch + Hub vs Tail bars -->
        <mxCell id="bf3-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1270" y="850" width="580" height="330" as="geometry" />
        </mxCell>
        <mxCell id="bf3-title" value="&lt;b style=&quot;color:#5B2C6F&quot;&gt;Stage 3 → Ripple profile&lt;/b&gt; &lt;span style=&quot;font-size:10px;color:#444&quot;&gt;(qualitative sketch)&lt;/span&gt;" style="text;html=1;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1270" y="855" width="580" height="20" as="geometry" />
        </mxCell>

        <!-- EPR curve sketch panel (left) -->
        <mxCell id="bf3-curvebg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#BBB;" vertex="1" parent="1">
          <mxGeometry x="1290" y="890" width="270" height="200" as="geometry" />
        </mxCell>
        <mxCell id="bf3-ylab" value="EPR %" style="text;html=1;align=center;fontSize=9;fontStyle=2;rotation=-90;" vertex="1" parent="1">
          <mxGeometry x="1280" y="970" width="40" height="20" as="geometry" />
        </mxCell>
        <mxCell id="bf3-xlab" value="hop d = 0 → 5" style="text;html=1;align=center;fontSize=9;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="1340" y="1090" width="120" height="15" as="geometry" />
        </mxCell>
        <!-- Hub source curve (red, high, slow decay) -->
        <mxCell id="bf3-hub-curve" style="endArrow=none;html=1;rounded=0;strokeColor=#B85450;strokeWidth=2.5;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1310" y="910"/>
              <mxPoint x="1350" y="920"/>
              <mxPoint x="1390" y="935"/>
              <mxPoint x="1430" y="945"/>
              <mxPoint x="1470" y="960"/>
              <mxPoint x="1530" y="980"/>
            </Array>
            <mxPoint x="1310" y="910" as="sourcePoint"/>
            <mxPoint x="1530" y="980" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <!-- Tail source curve (blue, lower, faster decay) -->
        <mxCell id="bf3-tail-curve" style="endArrow=none;html=1;rounded=0;strokeColor=#2F5B7C;strokeWidth=2.5;dashed=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1310" y="960"/>
              <mxPoint x="1350" y="990"/>
              <mxPoint x="1390" y="1015"/>
              <mxPoint x="1430" y="1040"/>
              <mxPoint x="1470" y="1055"/>
              <mxPoint x="1530" y="1065"/>
            </Array>
            <mxPoint x="1310" y="960" as="sourcePoint"/>
            <mxPoint x="1530" y="1065" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <!-- Hub-anchor mitigation curve (green dashed, low) -->
        <mxCell id="bf3-anchor-curve" style="endArrow=none;html=1;rounded=0;strokeColor=#2F6B2F;strokeWidth=2.5;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1310" y="1015"/>
              <mxPoint x="1350" y="1030"/>
              <mxPoint x="1390" y="1040"/>
              <mxPoint x="1430" y="1050"/>
              <mxPoint x="1470" y="1058"/>
              <mxPoint x="1530" y="1065"/>
            </Array>
            <mxPoint x="1310" y="1015" as="sourcePoint"/>
            <mxPoint x="1530" y="1065" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <!-- legend -->
        <mxCell id="bf3-leg-hub" value="— Hub source" style="text;html=1;align=left;fontSize=9;fontStyle=1;fontColor=#B85450;" vertex="1" parent="1">
          <mxGeometry x="1420" y="895" width="100" height="14" as="geometry" />
        </mxCell>
        <mxCell id="bf3-leg-tail" value="— Tail source" style="text;html=1;align=left;fontSize=9;fontStyle=1;fontColor=#2F5B7C;" vertex="1" parent="1">
          <mxGeometry x="1420" y="910" width="100" height="14" as="geometry" />
        </mxCell>
        <mxCell id="bf3-leg-anc" value="-- Hub-anchored" style="text;html=1;align=left;fontSize=9;fontStyle=1;fontColor=#2F6B2F;" vertex="1" parent="1">
          <mxGeometry x="1420" y="925" width="110" height="14" as="geometry" />
        </mxCell>

        <!-- Right side: Popularity paradox + mechanistic summary -->
        <mxCell id="bf3-rightbox" value="&lt;b&gt;Key findings&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px;text-align:left;display:inline-block&quot;&gt;• &lt;b style=&quot;color:#B85450&quot;&gt;Popularity Paradox&lt;/b&gt; — Hub neighbors flip ≫ Tail neighbors&lt;br/&gt;• &lt;b&gt;Innocent Bystander&lt;/b&gt; — Tail-source → Hub-neighbor collapse&lt;br/&gt;• &lt;b&gt;Narrow margin&lt;/b&gt; on Hub : decision boundary thinner&lt;br/&gt;• &lt;b&gt;Hub attention conduit&lt;/b&gt; : larger |Δ AttLift| at d1–d3&lt;br/&gt;• &lt;b style=&quot;color:#2F6B2F&quot;&gt;Mitigation&lt;/b&gt; — Hub-anchor KL reg. flattens long-range EPR&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#9673A6;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1580" y="890" width="255" height="200" as="geometry" />
        </mxCell>

        <mxCell id="bf3-cap" value="&lt;span style=&quot;font-size:10px&quot;&gt;Long-range ripple persists to d=5 ; mitigation is more effective when anchors are themselves Hubs.&lt;/span&gt;" style="text;html=1;align=center;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1280" y="1150" width="560" height="30" as="geometry" />
        </mxCell>

        <!-- ============ FIGURE CAPTION ============ -->
        <mxCell id="caption" value="&lt;b&gt;Figure X.&lt;/b&gt; Overview of the RippleEval pipeline. &lt;b style=&quot;color:#1F4E79&quot;&gt;Stage 1&lt;/b&gt; constructs an N-to-1 DAG knowledge graph G_fact via iterative LLM proposal and &lt;b style=&quot;color:#B35900&quot;&gt;external Wikidata validation&lt;/b&gt;, hard-coding the evaluation question into every edge. &lt;b style=&quot;color:#2F6B2F&quot;&gt;Stage 2&lt;/b&gt; stratifies entities by in-degree, performs &lt;i&gt;sub-tree constraint sampling&lt;/i&gt; around each target, and injects a counterfactual update through a LoRA mixture of targeted / neutral / OOD pairs. &lt;b style=&quot;color:#5B2C6F&quot;&gt;Stage 3&lt;/b&gt; compares the pre- and post-update model on the same fixed prompts, applies the Mask-B clean-correct filter, and reports per-hop EPR / Flip Rate plus white-box probes (Δ Margin, Δ Attention Lift). The dashed red loop indicates the mitigation feedback: mechanistic insight motivates injecting Hub QA as KL anchors back into the update objective." style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="30" y="1200" width="1840" height="60" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
