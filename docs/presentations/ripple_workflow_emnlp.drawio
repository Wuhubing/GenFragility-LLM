        <mxCell id="bf1-cap" value="&lt;span style=&quot;font-size:10px&quot;&gt;Many subjects collapse onto a single &lt;b style=&quot;color:#B85450&quot;&gt;Hub&lt;/b&gt; object via the N-to-1 constraint;&lt;br/&gt;sparse subjects form a &lt;b style=&quot;color:#2F5B7C&quot;&gt;Tail&lt;/b&gt;. Each edge stores its own &lt;i&gt;question&lt;/i&gt; string.&lt;/span&gt;" style="text;html=1;align=center;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="1150" width="560" height="30" as="geometry" />
        </mxCell>

        <!-- BAND FRAME 2: sub-tree fan-out d0..d5 -->
