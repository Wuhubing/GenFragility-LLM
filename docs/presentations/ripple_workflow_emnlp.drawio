        </mxCell>
        <mxCell id="bf2-title" value="&lt;b style=&quot;color:#2F6B2F&quot;&gt;Stage 2 → Sub-tree from a single target &lt;/b&gt;&lt;span style=&quot;font-size:10px;color:#444&quot;&gt;(path-continuous, capped per hop)&lt;/span&gt;" style="text;html=1;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="660" y="855" width="580" height="20" as="geometry" />
        </mxCell>

        <!-- Sub-tree fan-out illustration: d0 target + branches -->
        <mxCell id="bf2-d0" value="&lt;b&gt;d=0&lt;/b&gt;&lt;br/&gt;(s, r, o&apos;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=10;strokeWidth=2;" vertex="1" parent="1">
