{
  "description": "双裁判配置：GPT-4o-mini (线上) + Qwen3-14B (vLLM本地)",
  "judges": [
    {
      "model_name": "gpt-4o-mini",
      "api_base": "https://api.openai.com/v1",
      "api_key_env": "OPENAI_API_KEY",
      "temperature": 0.0,
      "enabled": true,
      "description": "OpenAI GPT-4o-mini 线上裁判"
    },
    {
      "model_name": "/root/target/models/qwen2-7b-instruct",
      "api_base": "http://127.0.0.1:8000/v1",
      "api_key": "local",
      "temperature": 0.0,
      "enabled": true,
      "description": "Qwen2.5-7B-Instruct vLLM 本地裁判"
    }
  ],
  "metadata": {
    "version": "1.0",
    "created": "2024-08-11",
    "setup_instructions": {
      "vllm_install": "pip install vllm",
      "model_download": "huggingface-cli download Qwen/Qwen2-7B-Instruct --local-dir /root/target/models/qwen2-7b-instruct",
      "vllm_start": "python -m vllm.entrypoints.openai.api_server --model /root/target/models/qwen2-7b-instruct --port 8000 --gpu-memory-utilization 0.9 --max-model-len 8192"
    }
  }
}